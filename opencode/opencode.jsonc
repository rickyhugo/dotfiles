{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "update": "notify",
  "formatter": true,
  "experimental": {
    "background_compaction": true,
  },
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": ["browse", "mcp"],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update",
        },
      },
    },
  },
}
