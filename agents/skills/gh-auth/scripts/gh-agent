#!/usr/bin/env python3
"""Run gh with this machine's PAT from macOS Keychain, without displaying it."""

import ctypes
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

ACCOUNT = "rickyhugo"
SERVICE = b"dev.dotfiles.gh-auth.github.com"


class AuthError(Exception):
    """An actionable diagnostic that contains no credential material."""


class Keychain:
    def __init__(self):
        self.security = ctypes.CDLL(
            "/System/Library/Frameworks/Security.framework/Security"
        )
        self.core = ctypes.CDLL(
            "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation"
        )
        pointer = ctypes.c_void_p
        length = ctypes.c_uint32
        string = ctypes.c_char_p
        signatures = {
            "SecKeychainSetUserInteractionAllowed": [ctypes.c_ubyte],
            "SecKeychainFindGenericPassword": [
                pointer,
                length,
                string,
                length,
                string,
                ctypes.POINTER(length),
                ctypes.POINTER(pointer),
                ctypes.POINTER(pointer),
            ],
            "SecKeychainAddGenericPassword": [
                pointer,
                length,
                string,
                length,
                string,
                length,
                string,
                ctypes.POINTER(pointer),
            ],
            "SecKeychainItemModifyAttributesAndData": [
                pointer,
                pointer,
                length,
                string,
            ],
            "SecKeychainItemFreeContent": [pointer, pointer],
        }
        for name, arguments in signatures.items():
            function = getattr(self.security, name)
            function.argtypes = arguments
            function.restype = ctypes.c_int32
        self.core.CFRelease.argtypes = [pointer]
        self.core.CFRelease.restype = None
        self._check(self.security.SecKeychainSetUserInteractionAllowed(False))

    @staticmethod
    def _check(status):
        if status == -25300:
            raise AuthError(
                "No agent PAT in Keychain. Import one with --import-pat-file."
            )
        if status:
            raise AuthError(
                f"Keychain access failed (OSStatus {status}); check that it is unlocked "
                "and permits this Python executable to access the agent PAT."
            )

    def _find(self):
        size = ctypes.c_uint32()
        data = ctypes.c_void_p()
        item = ctypes.c_void_p()
        account = ACCOUNT.encode()
        status = self.security.SecKeychainFindGenericPassword(
            None,
            len(SERVICE),
            SERVICE,
            len(account),
            account,
            ctypes.byref(size),
            ctypes.byref(data),
            ctypes.byref(item),
        )
        return status, size, data, item

    def _release(self, data, item):
        if data:
            self.security.SecKeychainItemFreeContent(None, data)
        if item:
            self.core.CFRelease(item)

    def load(self):
        status, size, data, item = self._find()
        try:
            self._check(status)
            return ctypes.string_at(data, size.value).decode()
        finally:
            self._release(data, item)

    def save(self, token):
        status, _, data, item = self._find()
        try:
            encoded = token.encode()
            if status == -25300:
                account = ACCOUNT.encode()
                status = self.security.SecKeychainAddGenericPassword(
                    None,
                    len(SERVICE),
                    SERVICE,
                    len(account),
                    account,
                    len(encoded),
                    encoded,
                    None,
                )
            else:
                self._check(status)
                status = self.security.SecKeychainItemModifyAttributesAndData(
                    item,
                    None,
                    len(encoded),
                    encoded,
                )
            self._check(status)
        finally:
            self._release(data, item)


def environment(token):
    result = dict(os.environ)
    for name in ("GITHUB_TOKEN", "GH_DEBUG", "DEBUG"):
        result.pop(name, None)
    result["GH_TOKEN"] = token
    result["GH_HOST"] = "github.com"
    result["GH_PROMPT_DISABLED"] = "1"
    return result


def verify(gh, token):
    result = subprocess.run(
        [gh, "api", "--hostname", "github.com", "user", "--jq", ".login"],
        env=environment(token),
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if result.returncode:
        # Captured diagnostics may contain sensitive information; keep them private.
        raise AuthError(
            "PAT identity verification failed; check token validity and connectivity."
        )
    if result.stdout.strip() != ACCOUNT:
        raise AuthError(
            f"PAT does not belong to expected account {ACCOUNT}; nothing was saved."
        )


def main(arguments=None):
    arguments = sys.argv[1:] if arguments is None else arguments
    if not arguments:
        print("Usage: gh-agent --check | --import-pat-file PATH | <gh arguments>")
        return 0
    gh = shutil.which("gh")
    if not gh:
        raise AuthError("gh is missing from PATH; activate the machine's mise shims.")
    if arguments[0] == "--import-pat-file":
        if len(arguments) != 2:
            raise AuthError("--import-pat-file requires one private file path.")
        path = Path(arguments[1])
        try:
            token = path.read_text().strip()
            if not token or any(character.isspace() for character in token):
                raise AuthError("The private file must contain one PAT.")
            verify(gh, token)
            keychain = Keychain()
            keychain.save(token)
            if keychain.load() != token:
                raise AuthError("Keychain read-back verification failed.")
        finally:
            path.unlink(missing_ok=True)
        print(
            json.dumps({"account": ACCOUNT, "host": "github.com", "store": "keychain"})
        )
        return 0
    auth_command = next(
        (
            arguments[index + 1]
            for index, value in enumerate(arguments[:-1])
            if value == "auth"
        ),
        None,
    )
    if auth_command == "token" or (
        auth_command == "status"
        and any(
            value.split("=")[0] == "--show-token"
            or (value.startswith("-") and not value.startswith("--") and "t" in value)
            for value in arguments
        )
    ):
        raise AuthError("Token display is unavailable through gh-agent.")
    token = Keychain().load()
    if arguments == ["--check"]:
        verify(gh, token)
        print(
            json.dumps({"account": ACCOUNT, "host": "github.com", "store": "keychain"})
        )
        return 0
    os.execve(gh, [gh, *arguments], environment(token))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except AuthError as error:
        print(f"gh-agent: {error}", file=sys.stderr)
        sys.exit(1)
    except Exception:  # noqa: BLE001
        # Never print exception details: subprocess exceptions may include env values.
        print(
            "gh-agent failed: check gh availability, PAT validity/account, network, "
            "and noninteractive Keychain access. Import files are removed after use.",
            file=sys.stderr,
        )
        sys.exit(1)
