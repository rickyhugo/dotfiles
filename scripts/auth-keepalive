#!/bin/zsh
# auth-keepalive: keep the gh and gcloud CLIs and opencode's MCP servers
# logged in, run by launchd.
#
#   auth-keepalive check      one pass (what launchd runs every few minutes)
#   auth-keepalive install    install and start the LaunchAgent
#   auth-keepalive uninstall  stop and remove the LaunchAgent
#   auth-keepalive status     show credential health and the agent state
#
# Anyfin's Google Workspace enforces Cloud SDK reauthentication (~16h), so the
# gcloud user login cannot be refreshed silently. Instead, when it lapses and
# you are at the keyboard, this opens the browser login for you, before
# anything else trips over it. ADC (application-default) is checked the same
# way. gh uses a non-expiring token, so it only gets a notification if it
# ever stops working.
#
# opencode keeps one credential store and its background server refreshes the
# MCP tokens that have a refresh token. A server whose login lapsed without one
# stays at "needs_auth" until someone signs in again, so that gets the same
# browser login. Servers never signed in to are left alone; `status` lists them.

set -u

SELF=${0:A}
LABEL="com.hugo.auth-keepalive"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/auth-keepalive.log"
STATE_DIR="$HOME/.local/state/auth-keepalive"
INTERVAL="${AUTH_KEEPALIVE_INTERVAL:-300}"     # seconds between checks
IDLE_LIMIT="${AUTH_KEEPALIVE_IDLE_LIMIT:-300}"  # only pop a login if active this recently
LOGIN_TIMEOUT=600                               # give up on an unanswered login after this
NOTIFY_COOLDOWN=3600                            # repeat a "fix this by hand" notice at most hourly

export PATH="$HOME/.local/bin:$HOME/.opencode/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# Our checks run every few minutes; keep them out of ~/.config/gcloud/logs.
export CLOUDSDK_CORE_DISABLE_FILE_LOGGING=1

mkdir -p "$STATE_DIR"

log() { print -r -- "$(date '+%F %T') $*"; }

notify() {
  local title=$1 message=$2
  if command -v terminal-notifier >/dev/null; then
    terminal-notifier -title "$title" -message "$message" -group "auth-keepalive-$title" >/dev/null 2>&1
  else
    osascript -e "display notification \"$message\" with title \"$title\"" >/dev/null 2>&1
  fi
}

# Seconds since the last keyboard or mouse input.
idle_seconds() {
  ioreg -c IOHIDSystem | awk '/HIDIdleTime/ { print int($NF / 1000000000); exit }'
}

user_is_present() { (( $(idle_seconds) < IDLE_LIMIT )); }

online() { curl -fsS -m 5 -o /dev/null https://www.google.com/generate_204 2>/dev/null; }

# Run the given function at most once per NOTIFY_COOLDOWN, keyed by name.
cooldown_ok() {
  local stamp="$STATE_DIR/$1.notified"
  if [[ -f $stamp ]] && (( $(date +%s) - $(stat -f %m "$stamp") < NOTIFY_COOLDOWN )); then
    return 1
  fi
  touch "$stamp"
}

gh_bin() { mise which gh 2>/dev/null || command -v gh; }

# Exit status 0 = healthy, 1 = needs login, 2 = unknown error (left alone).
gcloud_probe() {
  local err
  if err=$(gcloud "$@" --quiet 2>&1 >/dev/null); then
    return 0
  fi
  if [[ $err == *(Reauthentication|invalid_grant|auth login|application-default login)* ]]; then
    print -r -- "$err" | tail -1 > "$STATE_DIR/last-error"
    return 1
  fi
  log "gcloud $1 $2: unexpected error: $(print -r -- "$err" | tail -1)"
  return 2
}

# Run a browser login in the background and kill it if nobody completes it.
run_login() {
  local name=$1; shift
  log "$name: starting browser login"
  notify "$name" "Login expired — opening the browser to sign in again."
  "$@" 2>&1 &
  local pid=$! waited=0
  while kill -0 $pid 2>/dev/null; do
    if (( waited >= LOGIN_TIMEOUT )); then
      kill $pid 2>/dev/null
      log "$name: login not completed within ${LOGIN_TIMEOUT}s, will retry when you're back"
      return 1
    fi
    sleep 5; (( waited += 5 ))
  done
  if wait $pid; then
    log "$name: login completed"
    notify "$name" "Signed in again."
    rm -f "$STATE_DIR/$name.notified"
  else
    log "$name: login failed"
    return 1
  fi
}

check_gcloud() {
  command -v gcloud >/dev/null || return 0
  local account
  account=$(gcloud config get account 2>/dev/null)
  [[ -n $account ]] || return 0

  gcloud_probe auth print-access-token
  if (( $? == 1 )); then
    if user_is_present; then
      run_login gcloud gcloud auth login "$account" --brief --quiet
    else
      log "gcloud: login expired, waiting for you to be at the keyboard"
    fi
  fi

  if [[ -f $HOME/.config/gcloud/application_default_credentials.json ]]; then
    gcloud_probe auth application-default print-access-token
    if (( $? == 1 )); then
      if user_is_present; then
        run_login gcloud-adc gcloud auth application-default login --quiet
      else
        log "gcloud-adc: login expired, waiting for you to be at the keyboard"
      fi
    fi
  fi
}

check_gh() {
  local gh; gh=$(gh_bin) || return 0
  if "$gh" auth status --hostname github.com >/dev/null 2>&1; then
    rm -f "$STATE_DIR/gh.notified"
    return 0
  fi
  log "gh: token rejected"
  # gh's web login needs a terminal to show its one-time code, so just say so.
  cooldown_ok gh && notify "GitHub CLI" "Token no longer works — run: gh auth login"
}

# Talk to the running opencode server.
#   opencode_mcp list                  print "name<TAB>integrationID<TAB>lapsed|new"
#                                      for every MCP server at needs_auth
#   opencode_mcp login <id> <name>     browser login; returns once it completes
opencode_mcp() {
  python3 - "$@" <<'PY'
import json
import subprocess
import sys
import time


def api(*args, data=None):
    """Response data, or None on any failure (server down, HTTP error)."""
    argv = ["opencode", "api", *args]
    if data is not None:
        argv += ["-d", json.dumps(data)]
    try:
        result = subprocess.run(argv, capture_output=True, text=True,
                                stdin=subprocess.DEVNULL, timeout=30)
        body = json.loads(result.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None
    return body.get("data") if isinstance(body, dict) else None


def list_needs_auth():
    for server in api("GET", "/api/mcp") or []:
        ident = server.get("integrationID")
        if not ident or (server.get("status") or {}).get("status") != "needs_auth":
            continue
        integration = api("GET", f"/api/integration/{ident}")
        if integration is None:
            continue
        # A stored credential means the login worked once and has lapsed.
        state = "lapsed" if integration.get("connections") else "new"
        print(f"{server['name']}\t{ident}\t{state}")
    return 0


def login(ident, name):
    integration = api("GET", f"/api/integration/{ident}") or {}
    method = next((m["id"] for m in integration.get("methods") or []
                   if m.get("type") == "oauth"), None)
    base = f"/api/integration/{ident}/connect/oauth"
    attempt = api("POST", base, data={"methodID": method}) if method else None
    # "code" mode wants a code pasted back, which nobody is here to do.
    if not attempt or attempt.get("mode") != "auto":
        if attempt:
            api("DELETE", f"{base}/{attempt['attemptID']}")
        print(f"opencode-{name}: could not start a browser login")
        return 1

    path = f"{base}/{attempt['attemptID']}"
    subprocess.run(["open", attempt["url"]])
    while time.time() * 1000 < attempt["time"]["expires"]:
        time.sleep(3)
        status = (api("GET", path) or {}).get("status")
        if status == "complete":
            api("POST", f"/api/experimental/mcp/{name}/connect")
            return 0
        if status in ("failed", "expired"):
            return 1
    api("DELETE", path)
    return 1


if sys.argv[1] == "list":
    sys.exit(list_needs_auth())
sys.exit(login(*sys.argv[2:4]))
PY
}

check_opencode_mcp() {
  command -v opencode >/dev/null || return 0
  local line server id state name
  for line in "${(@f)$(opencode_mcp list)}"; do
    IFS=$'\t' read -r server id state <<< "$line"
    [[ $state == lapsed ]] || continue
    name="opencode-${server//[^A-Za-z0-9._-]/_}"
    if ! user_is_present; then
      log "$name: login expired, waiting for you to be at the keyboard"
    # An ignored browser tab should not come back on every pass.
    elif cooldown_ok "$name"; then
      run_login "$name" opencode_mcp login "$id" "$server"
    fi
  done
}

cmd_check() {
  if ! online; then
    return 0
  fi
  check_gh
  check_gcloud
  check_opencode_mcp
}

cmd_status() {
  local gh; gh=$(gh_bin)
  print -n "gh:          "; "$gh" auth status --hostname github.com >/dev/null 2>&1 && print ok || print "needs login"
  print -n "gcloud user: "; gcloud_probe auth print-access-token 2>/dev/null && print ok || print "needs login"
  print -n "gcloud ADC:  "; gcloud_probe auth application-default print-access-token 2>/dev/null && print ok || print "needs login"
  if command -v opencode >/dev/null; then
    local line server id state pending=()
    for line in "${(@f)$(opencode_mcp list)}"; do
      IFS=$'\t' read -r server id state <<< "$line"
      [[ -n $server ]] || continue
      [[ $state == lapsed ]] && pending+=("$server (expired)") || pending+=("$server (never signed in)")
    done
    print -n "opencode mcp:"; (( $#pending )) && print " needs login: ${(j:, :)pending}" || print " ok"
  fi
  print -n "agent:       "; launchctl print "gui/$UID/$LABEL" >/dev/null 2>&1 && print "loaded ($PLIST)" || print "not loaded"
  print    "log:         $LOG"
}

cmd_install() {
  local self=$SELF
  mkdir -p "${PLIST:h}" "${LOG:h}" "$HOME/.local/bin"
  ln -sf "$self" "$HOME/.local/bin/auth-keepalive"
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$self</string>
    <string>check</string>
  </array>
  <key>StartInterval</key><integer>$INTERVAL</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null
  launchctl bootstrap "gui/$UID" "$PLIST"
  print "Installed $PLIST (checks every ${INTERVAL}s). Log: $LOG"
}

cmd_uninstall() {
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null
  rm -f "$PLIST" "$HOME/.local/bin/auth-keepalive"
  print "Removed $LABEL"
}

case "${1:-}" in
  check) cmd_check ;;
  status) cmd_status ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  *) print -u2 "usage: ${0:t} check|status|install|uninstall"; exit 64 ;;
esac
